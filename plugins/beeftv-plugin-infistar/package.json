          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "视频模型 ID（如 kling-video-o1）。"
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "prompt",
              "description": "视频提示词。"
            },
            {
