{
  "name": "beeftv-plugin-infistar",
  "version": "1.0.0",
  "description": "内置无限星河 AI (Infistar) 多模态渠道插件，支持填写 API Key 一键同步 Claude、GPT、Gemini、DeepSeek、Qwen、GLM、Kimi、MiniMax 与 Seedream / GPT Image / Gemini Image / Seedance / MiniMax H3 / Wan / Kling 等 38 款文本、图像与视频模型。",
  "type": "module",
  "main": "./client/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "beeftv-plugin",
    "infistar",
    "multimodal",
    "image",
    "video",
    "seedance",
    "seedream",
    "wan",
    "kling"
  ],
  "beeftv": {
    "name": "无限星河 AI 多模态渠道",
    "client": "./client/index.js",
    "permissions": [
      "generation.run",
      "media.read",
      "ui.slot",
      "settings.write"
    ],
    "configuration": {
      "fields": [
        {
          "name": "apiKey",
          "type": "secret",
          "label": "无限星河 AI API Key",
          "required": true,
          "description": "填写无限星河 AI (https://infistar.cc) 提供的 sk-... 密钥"
        },
        {
          "name": "baseUrl",
          "type": "string",
          "label": "Base URL",
          "required": false,
          "default": "https://infistar.cc",
          "description": "无限星河 AI 接口根地址，国内优先 https://infistar.cc，备用 https://infistar.ai"
        }
      ]
    },
    "contributes": {
      "providers": [
        {
          "id": "infistar-gemini-image",
          "label": "无限星河 Gemini 原生图像生成 (Nano Banana / Gemini Image)",
          "capabilities": [
            "image"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://infistar.cc",
          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "Gemini 图像模型 ID（如 gemini-nano-banana-2.1、gemini-3-pro-image、gemini-3.1-flash-image、gemini-3.1-flash-lite-image）。"
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "contents[0].parts[0].text",
              "description": "图像描述提示词。"
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "contents[0].parts[].inlineData",
              "description": "参考图列表，用于图生图与多图参考编辑。"
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "generationConfig.imageConfig.aspectRatio",
              "description": "输出画幅比例（如 1:1、16:9、9:16、4:3、3:4、3:2、2:3、21:9）。"
            },
            {
              "name": "resolution",
              "type": "string",
              "required": false,
              "mapping": "generationConfig.imageConfig.imageSize",
              "description": "输出分辨率档位（1K / 2K / 4K）。"
            },
            {
              "name": "quality",
              "type": "string",
              "required": false,
              "mapping": "generationConfig.imageConfig.imageSize",
              "description": "图像质量档位（映射到 1K / 2K / 4K）。"
            }
          ],
          "validations": [
            {
              "assert": {
                "$eq": [
                  {
                    "$len": {
                      "$filter": {
                        "from": {
                          "$ref": "request.images"
                        },
                        "as": "media",
                        "where": {
                          "$eq": [
                            {
                              "$ref": "media.role"
                            },
                            "mask"
                          ]
                        }
                      }
                    }
                  },
                  0
                ]
              },
              "message": "无限星河 Gemini 图像协议不支持蒙版编辑，请移除蒙版后重试。"
            },
            {
              "assert": {
                "$and": [
                  {
                    "$eq": [
                      {
                        "$len": {
                          "$ref": "request.videos"
                        }
                      },
                      0
                    ]
                  },
                  {
                    "$eq": [
                      {
                        "$len": {
                          "$ref": "request.audios"
                        }
                      },
                      0
                    ]
                  }
                ]
              },
              "message": "无限星河 Gemini 图像协议不支持参考视频或音频。"
            }
          ],
          "create": {
            "method": "POST",
            "path": "/v1beta/models/{{model}}:generateContent",
            "originPath": true,
            "contentType": "application/json",
            "body": {
              "contents": [
                {
                  "role": "user",
                  "parts": {
                    "$concatArrays": [
                      [
                        {
                          "text": {
                            "$ref": "request.prompt"
                          }
                        }
                      ],
                      {
                        "$map": {
                          "from": {
                            "$sortByOrder": {
                              "$ref": "request.images"
                            }
                          },
                          "as": "media",
                          "in": {
                            "$if": {
                              "condition": {
                                "$ref": "media.dataUrl"
                              },
                              "then": {
                                "inlineData": {
                                  "mimeType": {
                                    "$dataMime": {
                                      "$ref": "media.dataUrl"
                                    }
                                  },
                                  "data": {
                                    "$dataPayload": {
                                      "$ref": "media.dataUrl"
                                    }
                                  }
                                }
                              },
                              "else": {
                                "fileData": {
                                  "mimeType": {
                                    "$omitEmpty": {
                                      "$ref": "media.mimeType"
                                    }
                                  },
                                  "fileUri": {
                                    "$ref": "media.url"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "generationConfig": {
                "responseModalities": [
                  "TEXT",
                  "IMAGE"
                ],
                "imageConfig": {
                  "aspectRatio": {
                    "$omitEmpty": {
                      "$if": {
                        "condition": {
                          "$in": [
                            {
                              "$lower": {
                                "$trim": {
                                  "$ref": "request.aspectRatio"
                                }
                              }
                            },
                            [
                              "",
                              "auto"
                            ]
                          ]
                        },
                        "then": null,
                        "else": {
                          "$ref": "request.aspectRatio"
                        }
                      }
                    }
                  },
                  "imageSize": {
                    "$omitEmpty": {
                      "$coalesce": [
                        {
                          "$switch": {
                            "cases": [
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.quality"
                                        }
                                      }
                                    },
                                    [
                                      "1k",
                                      "low"
                                    ]
                                  ]
                                },
                                "then": "1K"
                              },
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.quality"
                                        }
                                      }
                                    },
                                    [
                                      "2k",
                                      "medium"
                                    ]
                                  ]
                                },
                                "then": "2K"
                              },
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.quality"
                                        }
                                      }
                                    },
                                    [
                                      "4k",
                                      "high"
                                    ]
                                  ]
                                },
                                "then": "4K"
                              }
                            ],
                            "default": null
                          }
                        },
                        {
                          "$switch": {
                            "cases": [
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.resolution"
                                        }
                                      }
                                    },
                                    [
                                      "1k",
                                      "low"
                                    ]
                                  ]
                                },
                                "then": "1K"
                              },
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.resolution"
                                        }
                                      }
                                    },
                                    [
                                      "2k",
                                      "medium"
                                    ]
                                  ]
                                },
                                "then": "2K"
                              },
                              {
                                "when": {
                                  "$in": [
                                    {
                                      "$lower": {
                                        "$trim": {
                                          "$ref": "request.resolution"
                                        }
                                      }
                                    },
                                    [
                                      "4k",
                                      "high"
                                    ]
                                  ]
                                },
                                "then": "4K"
                              }
                            ],
                            "default": null
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "systemInstruction": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$ref": "request.instructions"
                    },
                    "then": {
                      "parts": [
                        {
                          "text": {
                            "$ref": "request.instructions"
                          }
                        }
                      ]
                    },
                    "else": null
                  }
                }
              }
            }
          },
          "response": {
            "status": "succeeded",
            "images": {
              "$map": {
                "from": {
                  "$filter": {
                    "from": {
                      "$flatMap": {
                        "from": {
                          "$ref": "response.candidates"
                        },
                        "as": "candidate",
                        "in": {
                          "$ref": "candidate.content.parts"
                        }
                      }
                    },
                    "as": "part",
                    "where": {
                      "$and": [
                        {
                          "$not": {
                            "$ref": "part.thought"
                          }
                        },
                        {
                          "$or": [
                            {
                              "$ref": "part.inlineData"
                            },
                            {
                              "$ref": "part.inline_data"
                            },
                            {
                              "$ref": "part.fileData"
                            },
                            {
                              "$ref": "part.file_data"
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "as": "part",
                "in": {
                  "$if": {
                    "condition": {
                      "$or": [
                        {
                          "$ref": "part.inlineData"
                        },
                        {
                          "$ref": "part.inline_data"
                        }
                      ]
                    },
                    "then": {
                      "dataUrl": {
                        "$concat": [
                          "data:",
                          {
                            "$coalesce": [
                              {
                                "$ref": "part.inlineData.mimeType"
                              },
                              {
                                "$ref": "part.inline_data.mime_type"
                              },
                              "image/png"
                            ]
                          },
                          ";base64,",
                          {
                            "$coalesce": [
                              {
                                "$ref": "part.inlineData.data"
                              },
                              {
                                "$ref": "part.inline_data.data"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "else": {
                      "url": {
                        "$coalesce": [
                          {
                            "$ref": "part.fileData.fileUri"
                          },
                          {
                            "$ref": "part.fileData.file_uri"
                          },
                          {
                            "$ref": "part.file_data.fileUri"
                          },
                          {
                            "$ref": "part.file_data.file_uri"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            },
            "text": {
              "$map": {
                "from": {
                  "$filter": {
                    "from": {
                      "$flatMap": {
                        "from": {
                          "$ref": "response.candidates"
                        },
                        "as": "candidate",
                        "in": {
                          "$ref": "candidate.content.parts"
                        }
                      }
                    },
                    "as": "part",
                    "where": {
                      "$and": [
                        {
                          "$not": {
                            "$ref": "part.thought"
                          }
                        },
                        {
                          "$ref": "part.text"
                        }
                      ]
                    }
                  }
                },
                "as": "part",
                "in": {
                  "$ref": "part.text"
                }
              }
            },
            "usage": {
              "$ref": "response.usageMetadata"
            },
            "errorPaths": [
              "error.code"
            ],
            "messagePaths": [
              "error.message"
            ],
            "detectImageMime": true
          }
        },
        {
          "id": "infistar-image",
          "label": "无限星河图像生成与编辑 (Seedream / GPT Image / Qwen / Wan / Grok)",
          "capabilities": [
            "image"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://infistar.cc",
          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "图像模型 ID（如 doubao-seedream-5-0-260128、gpt-image-2.5-flare、qwen-image-2.0-pro、wan2.7-image-pro、grok-imagine-image）。"
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "prompt",
              "description": "图像描述或编辑提示词。"
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "image / mask",
              "description": "参考图或蒙版；传入参考图时自动走 /v1/images/edits multipart。"
            },
            {
              "name": "imageCount",
              "type": "integer",
              "required": false,
              "mapping": "n",
              "description": "生成张数（默认 1）。"
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "size",
              "description": "输出尺寸（如 1024x1024、2048x2048、1536x1024 等）。"
            },
            {
              "name": "quality",
              "type": "string",
              "required": false,
              "mapping": "quality",
              "description": "图片质量档位。"
            }
          ],
          "create": {
            "method": "POST",
            "path": "/v1/images/generations",
            "pathTemplate": {
              "$if": {
                "condition": {
                  "$gt": [
                    {
                      "$len": {
                        "$ref": "request.images"
                      }
                    },
                    0
                  ]
                },
                "then": "/v1/images/edits",
                "else": "/v1/images/generations"
              }
            },
            "contentType": "application/json",
            "contentTypeTemplate": {
              "$if": {
                "condition": {
                  "$gt": [
                    {
                      "$len": {
                        "$ref": "request.images"
                      }
                    },
                    0
                  ]
                },
                "then": "multipart/form-data",
                "else": "application/json"
              }
            },
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "prompt": {
                "$ref": "request.prompt"
              },
              "n": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$gt": [
                        {
                          "$ref": "request.imageCount"
                        },
                        0
                      ]
                    },
                    "then": {
                      "$ref": "request.imageCount"
                    },
                    "else": 1
                  }
                }
              },
              "size": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$in": [
                        {
                          "$lower": {
                            "$trim": {
                              "$ref": "request.aspectRatio"
                            }
                          }
                        },
                        [
                          "",
                          "auto"
                        ]
                      ]
                    },
                    "then": null,
                    "else": {
                      "$ref": "request.aspectRatio"
                    }
                  }
                }
              },
              "quality": {
                "$omitEmpty": {
                  "$switch": {
                    "cases": [
                      {
                        "when": {
                          "$in": [
                            {
                              "$lower": {
                                "$trim": {
                                  "$ref": "request.quality"
                                }
                              }
                            },
                            [
                              "1k"
                            ]
                          ]
                        },
                        "then": "low"
                      },
                      {
                        "when": {
                          "$in": [
                            {
                              "$lower": {
                                "$trim": {
                                  "$ref": "request.quality"
                                }
                              }
                            },
                            [
                              "2k"
                            ]
                          ]
                        },
                        "then": "medium"
                      },
                      {
                        "when": {
                          "$in": [
                            {
                              "$lower": {
                                "$trim": {
                                  "$ref": "request.quality"
                                }
                              }
                            },
                            [
                              "4k"
                            ]
                          ]
                        },
                        "then": "high"
                      },
                      {
                        "when": {
                          "$in": [
                            {
                              "$lower": {
                                "$trim": {
                                  "$ref": "request.quality"
                                }
                              }
                            },
                            [
                              "",
                              "auto"
                            ]
                          ]
                        },
                        "then": null
                      }
                    ],
                    "default": {
                      "$ref": "request.quality"
                    }
                  }
                }
              },
              "background": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$eq": [
                        {
                          "$ref": "request.extra.transparentBackground"
                        },
                        "true"
                      ]
                    },
                    "then": "transparent",
                    "else": null
                  }
                }
              }
            },
            "files": [
              {
                "name": "image",
                "source": {
                  "$filter": {
                    "from": {
                      "$sortByOrder": {
                        "$ref": "request.images"
                      }
                    },
                    "as": "media",
                    "where": {
                      "$ne": [
                        {
                          "$ref": "media.role"
                        },
                        "mask"
                      ]
                    }
                  }
                },
                "filename": "image.png"
              },
              {
                "name": "mask",
                "source": {
                  "$first": {
                    "$filter": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.images"
                        }
                      },
                      "as": "media",
                      "where": {
                        "$eq": [
                          {
                            "$ref": "media.role"
                          },
                          "mask"
                        ]
                      }
                    }
                  }
                },
                "filename": "mask.png"
              }
            ]
          },
          "response": {
            "status": "succeeded",
            "images": {
              "$map": {
                "from": {
                  "$ref": "response.data"
                },
                "as": "item",
                "in": {
                  "url": {
                    "$if": {
                      "condition": {
                        "$ref": "item.b64_json"
                      },
                      "then": null,
                      "else": {
                        "$omitEmpty": {
                          "$ref": "item.url"
                        }
                      }
                    }
                  },
                  "dataUrl": {
                    "$if": {
                      "condition": {
                        "$ref": "item.b64_json"
                      },
                      "then": {
                        "$concat": [
                          "data:image/png;base64,",
                          {
                            "$ref": "item.b64_json"
                          }
                        ]
                      },
                      "else": null
                    }
                  }
                }
              }
            },
            "usage": {
              "$ref": "response.usage"
            },
            "errorPaths": [
              "error.code"
            ],
            "messagePaths": [
              "error.message"
            ],
            "resultEphemeral": true,
            "detectImageMime": true
          }
        },
        {
          "id": "infistar-video",
          "label": "无限星河异步视频生成 (Seedance / MiniMax H3 / Wan)",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://infistar.cc",
          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "视频模型 ID（如 doubao-seedance-2-5-260628、doubao-seedance-2-0-fast-260128、doubao-seedance-2.0-mini、MiniMax-H3、wan3.0-video、wan2.7-i2v、wan2.7-t2v）。"
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "prompt",
              "description": "视频提示词。"
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "input_reference",
              "description": "单张参考图 / 首帧图（multipart 文件上传）。"
            },
            {
              "name": "duration",
              "type": "integer",
              "required": false,
              "mapping": "seconds",
              "description": "视频时长秒数。"
            },
            {
              "name": "resolution",
              "type": "string",
              "required": false,
              "mapping": "size / resolution",
              "description": "分辨率档位（如 480p、720p、768p、1080p、2K）。"
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "ratio / aspect_ratio",
              "description": "画幅比例（如 16:9、9:16、1:1、4:3、3:4、21:9）。"
            }
          ],
          "validations": [
            {
              "assert": {
                "$lte": [
                  {
                    "$len": {
                      "$ref": "request.images"
                    }
                  },
                  1
                ]
              },
              "message": "无限星河 /v1/videos 协议单次最多支持 1 张参考图，请移除多余图片后重试。"
            },
            {
              "assert": {
                "$eq": [
                  {
                    "$len": {
                      "$ref": "request.videos"
                    }
                  },
                  0
                ]
              },
              "message": "无限星河 /v1/videos 协议当前不支持参考视频输入。"
            },
            {
              "assert": {
                "$eq": [
                  {
                    "$len": {
                      "$ref": "request.audios"
                    }
                  },
                  0
                ]
              },
              "message": "无限星河 /v1/videos 协议当前不支持参考音频输入。"
            },
            {
              "assert": {
                "$eq": [
                  {
                    "$len": {
                      "$filter": {
                        "from": {
                          "$ref": "request.images"
                        },
                        "as": "media",
                        "where": {
                          "$in": [
                            {
                              "$ref": "media.role"
                            },
                            [
                              "mask",
                              "last_frame"
                            ]
                          ]
                        }
                      }
                    }
                  },
                  0
                ]
              },
              "message": "无限星河 /v1/videos 协议当前不支持尾帧或蒙版输入。"
            }
          ],
          "variables": [
            {
              "name": "normalizedResolution",
              "value": {
                "$switch": {
                  "cases": [
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "480p"
                        ]
                      },
                      "then": "480p"
                    },
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "720p"
                        ]
                      },
                      "then": "720p"
                    },
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "768p"
                        ]
                      },
                      "then": "768p"
                    },
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "1080p"
                        ]
                      },
                      "then": "1080p"
                    },
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "2k"
                        ]
                      },
                      "then": "2K"
                    },
                    {
                      "when": {
                        "$eq": [
                          {
                            "$lower": {
                              "$trim": {
                                "$ref": "request.resolution"
                              }
                            }
                          },
                          "4k"
                        ]
                      },
                      "then": "4K"
                    }
                  ],
                  "default": {
                    "$omitEmpty": {
                      "$trim": {
                        "$ref": "request.resolution"
                      }
                    }
                  }
                }
              }
            },
            {
              "name": "normalizedRatio",
              "value": {
                "$if": {
                  "condition": {
                    "$in": [
                      {
                        "$lower": {
                          "$trim": {
                            "$ref": "request.aspectRatio"
                          }
                        }
                      },
                      [
                        "",
                        "adaptive",
                        "auto"
                      ]
                    ]
                  },
                  "then": null,
                  "else": {
                    "$trim": {
                      "$ref": "request.aspectRatio"
                    }
                  }
                }
              }
            }
          ],
          "create": {
            "method": "POST",
            "path": "/v1/videos",
            "contentType": "multipart/form-data",
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "prompt": {
                "$ref": "request.prompt"
              },
              "seconds": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$gt": [
                        {
                          "$ref": "request.duration"
                        },
                        0
                      ]
                    },
                    "then": {
                      "$toString": {
                        "$ref": "request.duration"
                      }
                    },
                    "else": null
                  }
                }
              },
              "size": {
                "$omitEmpty": {
                  "$ref": "vars.normalizedResolution"
                }
              },
              "resolution": {
                "$omitEmpty": {
                  "$ref": "vars.normalizedResolution"
                }
              },
              "ratio": {
                "$omitEmpty": {
                  "$ref": "vars.normalizedRatio"
                }
              },
              "aspect_ratio": {
                "$omitEmpty": {
                  "$ref": "vars.normalizedRatio"
                }
              }
            },
            "files": [
              {
                "name": "input_reference",
                "source": {
                  "$first": {
                    "$filter": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.images"
                        }
                      },
                      "as": "media",
                      "where": {
                        "$ne": [
                          {
                            "$ref": "media.role"
                          },
                          "mask"
                        ]
                      }
                    }
                  }
                },
                "filename": "input-reference.png"
              }
            ]
          },
          "poll": {
            "method": "GET",
            "path": "/v1/videos/{{taskId}}"
          },
          "cancel": {
            "method": "DELETE",
            "path": "/v1/videos/{{taskId}}"
          },
          "result": {
            "method": "GET",
            "path": "/v1/videos/{{taskId}}/content",
            "headers": {
              "Accept": "video/mp4"
            }
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "response.taskId"
                },
                {
                  "$ref": "response.data.id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$coalesce": [
                {
                  "$ref": "response.status"
                },
                {
                  "$ref": "response.state"
                },
                {
                  "$ref": "response.data.status"
                },
                "pending"
              ]
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                },
                {
                  "$ref": "response.fail_reason"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$ref": "response.metadata.url"
                },
                {
                  "$ref": "response.video_url"
                },
                {
                  "$ref": "response.videoUrl"
                },
                {
                  "$ref": "response.result_url"
                },
                {
                  "$ref": "response.url"
                },
                {
                  "$ref": "response.data.metadata.url"
                },
                {
                  "$ref": "response.data.video_url"
                },
                {
                  "$ref": "response.data.result_url"
                },
                {
                  "$ref": "response.data.url"
                }
              ]
            },
            "errorPaths": [
              "error.code"
            ],
            "messagePaths": [
              "error.message"
            ],
            "resultEphemeral": true
          }
        },
        {
          "id": "infistar-video-json",
          "label": "无限星河 JSON 异步视频生成 (Kling O1)",
          "capabilities": [
            "video"
          ],
