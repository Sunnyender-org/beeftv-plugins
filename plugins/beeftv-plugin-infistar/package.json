                          "$ref": "request.duration"
                        },
                        0
                      ]
                    },
                    "then": {
                      "$ref": "request.duration"
                    },
                    "else": null
                  }
                }
              },
              "aspect_ratio": {
                "$omitEmpty": {
                  "$if": {
                    "condition": {
                      "$in": [
                        {
                          "$lower": {
                            "$trim": {
                              "$ref": "request.aspectRatio"
                            }
                          }
                        },
                        [
                          "",
                          "adaptive",
                          "auto"
                        ]
                      ]
                    },
                    "then": null,
                    "else": {
                      "$trim": {
                        "$ref": "request.aspectRatio"
                      }
                    }
                  }
                }
              },
              "resolution": {
                "$omitEmpty": {
                  "$lower": {
                    "$trim": {
                      "$ref": "request.resolution"
                    }
                  }
                }
              },
              "image": {
                "$omitEmpty": {
                  "$first": {
                    "$map": {
                      "from": {
                        "$filter": {
                          "from": {
                            "$sortByOrder": {
                              "$ref": "request.images"
                            }
                          },
                          "as": "media",
                          "where": {
                            "$ne": [
                              {
                                "$ref": "media.role"
                              },
                              "mask"
                            ]
                          }
                        }
                      },
                      "as": "media",
                      "in": {
                        "$ref": "media.value"
                      }
                    }
                  }
                }
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/v1/videos/{{taskId}}"
          },
          "result": {
            "method": "GET",
            "path": "/v1/videos/{{taskId}}/content",
            "headers": {
              "Accept": "video/mp4"
            }
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "response.taskId"
                },
                {
                  "$ref": "response.data.id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
